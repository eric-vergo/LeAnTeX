140,"text":"The procedure was as follows. "},{"x":9848094,"y":31771460,"w":20971520,"h":462029,"d":135004,"text":" 1. Release the bob from the initial angle. "},{"x":9848094,"y":33082180,"w":20971520,"h":462029,"d":135004,"text":" 2. Record the amplitude after each full swing. "},{"x":9848094,"y":34392900,"w":20971520,"h":454820,"d":135004,"text":" 3. Repeat the measurement ten times and average. "},{"x":8209694,"y":36561158,"w":22609920,"h":654940,"d":188744,"text":"3 Theory "},{"x":8209694,"y":37997248,"w":22609920,"h":491520,"d":163840,"text":"For small angles the angle \u0012(t) obeys "},{"x":16803906,"y":39439040,"w":5421496,"h":610631,"d":162016,"text":"\u007f\u0012 + 2\u000c_\u0012 + !20\u0012 = 0;"},{"x":29982064,"y":39439040,"w":837550,"h":491520,"d":163840,"text":"(1)"},{"x":8209694,"y":40880832,"w":22609920,"h":622230,"d":190422,"text":"whose underdamped solution is \u0012(t) = \u00120e\u0000\u000ct cos(!t + ') with ! = p!20 \u0000 \u000c2."},{"x":8209694,"y":41667264,"w":22609920,"h":556402,"d":163840,"text":"The period is T = 2\u0019/!, and the amplitude after n swings is \u0012n = \u00120e\u0000\u000cnT. "},{"x":8209694,"y":43835522,"w":22609920,"h":654940,"d":10381,"text":"4 Results "},{"x":8209694,"y":45271612,"w":22609920,"h":469238,"d":135004,"text":"A straight-line fit of the last column against n in Table 1 gives a slope of \u00000:0386"},{"x":8209694,"y":46058044,"w":22609920,"h":533465,"d":135004,"text":"per swing. With T = 1:84 s this yields \u000c = 0:021 s\u00001, with an uncertainty of"},{"x":8209694,"y":46844476,"w":22609920,"h":491520,"d":36700,"text":"about 5%. "},{"x":8209694,"y":49431838,"w":22609920,"h":436470,"d":0,"text":" 1 "}],"rules":[[28411708,40284815,2225716,26213]],"body":{"width":22609920,"height":39190528,"depth":0,"glueSign":1,"glueOrder":2,"glueSet":88754.5703,"items":[["o","whatsit"],["glue",655360,0,0,0,0,10],["h",0,0,0,0,""],["glue",1310720,0,0,0,0,0],["glue",-1310720,0,0,0,0,0],["p",-51],["glue",1310720,0,0,0,0,0],["g