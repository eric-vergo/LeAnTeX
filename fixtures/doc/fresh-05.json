{"meta":{"engine":"This is LuaHBTeX, Version 1.21.0 (TeX Live 2025)","format":"lualatex"},"params":{"textwidth":25559040,"textheight":35946496,"topskip":[786432,0,0,0,0],"parskip":[0,65536,0,0,0],"parindent":1179648,"baselineskip":[950272,0,0,0,0],"oddsidemargin":2555904,"topmargin":1114112,"headheight":786432,"headsep":1638400,"footskip":1966080,"maxdepth":393216,"widowpenalty":150,"clubpenalty":150},"pages":[{"number":1,"pagewidth":40258437,"pageheight":52099153,"lines":[{"x":7292190,"y":12272926,"w":25559040,"h":973199,"d":279999,"text":" A Walking Tour of the Old Harbour "},{"x":15689398,"y":14632222,"w":8764625,"h":825750,"d":353898,"text":" Cornelius Whitlock "},{"x":7292190,"y":16513790,"w":25559040,"h":675702,"d":194406,"text":" August 20, 2021 "},{"x":7292190,"y":19993882,"w":25559040,"h":789326,"d":227625,"text":"1 Beginning at the Quay "},{"x":7292190,"y":21723744,"w":25559040,"h":554435,"d":162005,"text":"The tour starts where the ferries once docked, beside a weathered lighthouse"},{"x":7292190,"y":22674016,"w":25559040,"h":554435,"d":162005,"text":"that no longer guides any ship. Visitors are advised to wear comfortable"},{"x":7292190,"y":23624288,"w":25559040,"h":554435,"d":161219,"text":"shoes, since the cobblestones are uneven and frequently wet. "},{"x":9258270,"y":25426528,"w":21626880,"h":545784,"d":152568,"text":" The harbour is not a place but a conversation between the land"},{"x":9258270,"y":26376800,"w":21626880,"h":554435,"d":162005,"text":"and the sea, and neither side has ever finished speaking. "},{"x":7292190,"y":28658042,"w":25559040,"h":654940,"d":5662,"text":"1.1 The Fish Market "},{"x":7292190,"y":30116742,"w":25559040,"h":554435,"d":161219,"text":"Early risers will find the market at its liveliest. Traders call out prices in"},{"x":7292190,"y":31067014,"w":25559040,"h":545784,"d":161219,"text":"a rapid, incomprehensible dialect, and the unwary purchaser may discover"},{"x":7292190,"y":32017286,"w":25559040,"h":545784,"d":162005,"text":"that haggling is expected. "},{"x":7292190,"y":34298528,"w":25559040,"h":657771,"d":10381,"text":"1.2 The Customs House "},{"x":7292190,"y":35757228,"w":25559040,"h":545784,"d":162005,"text":"The handsome building opposite was constructed in the nineteenth century."},{"x":7292190,"y":36707500,"w":25559040,"h":554435,"d":162005,"text":"Its facade, though blackened by decades of coal smoke, retains remarkable"},{"x":7292190,"y":37657772,"w":25559040,"h":634566,"d":8651,"text":"ornamental detail.1 "},{"x":7292190,"y":40285896,"w":25559040,"h":790458,"d":227625,"text":"2 Along the Breakwater "},{"x":7292190,"y":42015758,"w":25559040,"h":563085,"d":162005,"text":"A long walk follows, rewarded by an unobstructed view across the bay. "},{"x":7292190,"y":43436054,"w":25559040,"h":550502,"d":235932,"text":" 1Guided tours of the interior run on Saturdays. "},{"x":7292190,"y":46187806,"w":25559040,"h":523764,"d":0,"text":" 1 "}],"rules":[[7292190,42688944,10223460,26214]],"body":{"width":25559040,"height":35946496,"depth":0,"glueSign":1,"glueOrder":2,"glueSet":112238.859,"items":[["o","whatsit"],["glue",786432,0,0,0,0,10],["h",0,0,0,0,""],["glue",1572864,0,0,0,0,0],["glue",-1572864,0,0,0,0,0],["p",-51],["glue",1572864,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",665201,0,0,0,0,2],["h",25559040,973199,279999,0," A Walking Tour of the Old Harbour "],["glue",1179648,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",73899,0,0,0,0,2],["h",25559040,825750,353898,0," Cornelius Whitlock "],["glue",786432,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",65536,0,0,0,0,1],["h",25559040,675702,194406,0," August 20, 2021 "],["p",-51],["glue",851968,393216,0,524288,0,0],["glue",1179648,0,0,0,0,0],["glue",-1374054,0,0,0,0,0],["p",-300],["glue",194406,0,0,0,0,0],["glue",1179648,0,0,0,0,0],["glue",-1179648,0,0,0,0,0],["glue",1186332,338952,0,67789,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",458060,0,0,0,0,2],["h",25559040,7