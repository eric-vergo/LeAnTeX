{"meta":{"engine":"This is LuaHBTeX, Version 1.21.0 (TeX Live 2025)","format":"lualatex"},"params":{"textwidth":23592960,"textheight":35481206,"topskip":[720896,0,0,0,0],"parskip":[0,65536,0,0,0],"parindent":1114112,"baselineskip":[891290,0,0,0,0],"oddsidemargin":3538944,"topmargin":1376256,"headheight":786432,"headsep":1638400,"footskip":1966080,"maxdepth":360448,"widowpenalty":150,"clubpenalty":150},"pages":[{"number":1,"pagewidth":40258437,"pageheight":52099153,"lines":[{"x":8275230,"y":12135300,"w":23592960,"h":798386,"d":233287,"text":" Reflections on Reading Slowly "},{"x":16978280,"y":14129232,"w":6186861,"h":642250,"d":275254,"text":" Imogen Tarrant "},{"x":8275230,"y":15738141,"w":23592960,"h":545784,"d":151781,"text":" December 1, 2017 "},{"x":8275230,"y":18463135,"w":23592960,"h":660603,"d":10381,"text":"1 An Unfashionable Habit "},{"x":8275230,"y":20065802,"w":23592960,"h":505921,"d":147830,"text":"There is something faintly subversive about reading a single book for a whole"},{"x":8275230,"y":20957092,"w":23592960,"h":505921,"d":147830,"text":"month. In an age of constant notification, sustained attention has become"},{"x":8275230,"y":21848382,"w":23592960,"h":505921,"d":147112,"text":"an extraordinary accomplishment, and the pleasures of a well-constructed"},{"x":8275230,"y":22739672,"w":23592960,"h":498028,"d":147830,"text":"paragraph are easily overlooked. "},{"x":10069277,"y":24137766,"w":20004866,"h":498028,"d":147112,"text":" To read slowly is not to read less; it is to allow each sentence to"},{"x":10069277,"y":25029056,"w":20004866,"h":505921,"d":147830,"text":"finish what it has begun to say. "},{"x":8275230,"y":26427151,"w":23592960,"h":538214,"d":179405,"text":"Several practical suggestions follow, drawn from the references [1, 2]. "},{"x":8275230,"y":28305872,"w":23592960,"h":548143,"d":8651,"text":"1.1 Guidelines "},{"x":10069277,"y":29661103,"w":21798913,"h":505921,"d":147112,"text":" 1. Choose a book you suspect is difficult. "},{"x":10069277,"y":31049008,"w":21798913,"h":505921,"d":147112,"text":" 2. Read at a fixed hour, preferably at the same table. "},{"x":10069277,"y":32436913,"w":21798913,"h":498028,"d":139218,"text":" 3. Keep a notebook, and record "},{"x":11648036,"y":33824818,"w":20220154,"h":505921,"d":138500,"text":" • unfamiliar words, "},{"x":11648036,"y":34885043,"w":20220154,"h":498028,"d":147830,"text":" • passages that surprised you, "},{"x":11648036,"y":35945268,"w":20220154,"h":505921,"d":139218,"text":" • questions for later. "},{"x":10069277,"y":37333172,"w":21798913,"h":505921,"d":147112,"text":" ? Never finish a chapter merely to finish it. "},{"x":8275230,"y":39551361,"w":23592960,"h":658715,"d":5662,"text":"2 A Modest Mathematical Aside "},{"x":8275230,"y":41154028,"w":23592960,"h":505921,"d":147830,"text":"Suppose a reader finishes p pages per day of a book of N pages. The time"},{"x":8275230,"y":42045318,"w":23592960,"h":538214,"d":179404,"text":"taken is N/p days, so halving the speed doubles the time: "},{"x":18031053,"y":43707373,"w":4081314,"h":975846,"d":671655,"text":" N p/2 = 2 \u0001 N p :"},{"x":8275230,"y":45984660,"w":23592960,"h":477934,"d":0,"text":" 1 "}],"rules":[[18109696,43513617,1078672,28704],[21179559,43513617,654826,28704]],"body":{"width":23592960,"height":35481206,"depth":0,"glueSign":2,"glueOrder":0,"glueSet":0.711128712,"items":[["o","whatsit"],["glue",720896,0,0,0,0,10],["h",0,0,0,0,""],["glue",1435238,0,0,0,0,0],["glue",-1435238,0,0,0,0,0],["p",-51],["glue",1435238,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",643406,0,0,0,0,2],["h",23592960,798386,233287,0," Reflections on Reading Slowly "],["glue",1076428,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",41967,0,0,0,0,2],["h",23592960,642250,275254,0," Imogen Tarrant "],["glue",717619,0,0,0,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",70252,0,0,0,0,2],["h",23592960,545784,151781,0," December 1, 2017 "],["p",-51],["glue",786432,262144,0,393216,0,0]