112,1794047," • Radishes, which are ready in about a month. "],["glue",655360,262144,0,131072,0,0],["k",-196608,1],["rule",9437040,26214,0],["k",170394,1],["h",23592960,512445,216271,0," 1A simple test is to dig a hole, fill it with water, and measure how long it takes to empty. "],["glue",-216271,0,0,0,0,0],["glue",0,7,2,0,0,0]]}},{"number":2,"pagewidth":40258437,"pageheight":52099153,"lines":[{"x":10069277,"y":9258270,"w":21798913,"h":505921,"d":147830,"text":" • Lettuce and other leafy greens, including "},{"x":11648036,"y":10739384,"w":20220154,"h":498028,"d":139218,"text":" – spinach in the cool seasons, "},{"x":11648036,"y":11892818,"w":20220154,"h":498028,"d":147830,"text":" – chard, which survives almost any neglect. "},{"x":10069277,"y":13373932,"w":21798913,"h":498028,"d":147830,"text":" • Beans, both bush and climbing varieties. "},{"x":8275230,"y":14855046,"w":23592960,"h":513815,"d":147830,"text":"A rough weekly routine might run as follows. "},{"x":10069277,"y":16336160,"w":21798913,"h":505921,"d":139218,"text":" 1. Inspect the plants for pests and disease. "},{"x":10069277,"y":17817274,"w":21798913,"h":505921,"d":147830,"text":" 2. Water deeply, preferably in the early morning. "},{"x":10069277,"y":19298388,"w":21798913,"h":505921,"d":147112,"text":" 3. Remove weeds before they set seed: "},{"x":11648036,"y":20779502,"w":20220154,"h":538214,"d":179405,"text":" (a) pull small ones by hand, "},{"x":11648036,"y":21932936,"w":20220154,"h":538214,"d":179405,"text":" (b) hoe the larger ones between rows. "},{"x":10069277,"y":23414050,"w":21798913,"h":498028,"d":139218,"text":" 4. Harvest whatever is ripe. "},{"x":8275230,"y":25676227,"w":23592960,"h":657771,"d":189687,"text":"3 Spacing "},{"x":8275230,"y":27278894,"w":23592960,"h":505921,"d":147830,"text":"Seed packets give spacing in inches, but a useful rule is that a bed of width"},{"x":8275230,"y":28170184,"w":23592960,"h":598293,"d":179404,"text":"w feet and length ` feet holds roughly n \u0019 4w`/s2 plants when the spacing"},{"x":8275230,"y":29061474,"w":23592960,"h":538214,"d":179404,"text":"is s inches, scaled by 144/4. Overcrowded plants compete for light, water"},{"x":8275230,"y":29952764,"w":23592960,"h":498028,"d":147830,"text":"and nutrients, and disease spreads rapidly among them. "},{"x":8275230,"y":32416918,"w":23592960,"h":505921,"d":147830,"text":" Happy gardening, and may the frost arrive late. "},{"x":8275230,"y":45984660,"w":23592960,"h":477934,"d":0,"text":" 2 "}],"rules":[],"body":{"width":23592960,"height":35481206,"depth":0,"glueSign":1,"glueOrder":2,"glueSet":165.009689,"items":[["glue",214975,0,0,0,0,10],["h",21798913,505921,147830,1794047," • Lettuce and other leafy greens, including "],["p",-51],["glue",589824,262144,0,131072,0,0],["glue",-589824,-262144,0,-131072,0,0],["glue",458752,196608,0,65536,0,0],["glue",131072,65536,0,65536,0,3],["glue",0,0,0,0,0,3],["glue",245432,0,0,0,0,2],["h",20220154,498028,139218,3372806," – spinach in the cool seasons, "],["p",-51],["glue",131072,65536,0,65536,0,0],["glue",131072,65536,0,65536,0,3],["glue",0,0,0,0,0,3],["glue",254044,0,0,0,0,2],["h",20220154,498028,147830,3372806," – chard, which survives almost any neglect. "],["p",-51],["glue",294912,131072,0,65536,0,0],["glue",-442742,-131072,0,-65536,0,0],["p",-51],["glue",147830,0,0,0,0,0],["glue",294912,131072,0,65536,0,0],["glue",294912,131072,0,65536,0,3],["glue",0,0,0,0,0,3],["glue",245432,0,0,0,0,2],["h",21798913,498028,147830,1794047," • Beans, both bush and climbing varieties. "],["p",-51],["glue",589824,196608,0,327680,0,0],["glue",0,65536,0,0,0,3],["glue",0,0,0,0,0,3],["glue",229645,0,0,0,0,2],["h",23592960,513815,147830,0,"A rough weekly routine might run as follows. "],["p",-51],["glue",589824,262144,0,327680,0,0],["glue",-589824,-262144,0,-327680,0,0],["glue",294912,131072,0,262144,0,0],["glue",294912,131072,0,65536,0,3],["glue",0,0,0,0,0,3],["glue",237539,0,0,0,0,2],["h",21798913,505921,139218,1794047," 1. Inspect the plants for pests and 