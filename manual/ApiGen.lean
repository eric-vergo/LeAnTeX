/-!
# `leantex-manual-api`: the API reference's pages

`lake exe leantex-manual-api` (run in `manual/`) writes one page per module of the library
(every `.lean` file under `../LeAnTeX/`, and `../LeAnTeX.lean`) into `LeAnTeXManual/Api/`, and
the index `LeAnTeXManual/Api.lean`, which imports and includes them. A page holds only the
module's name: its content is computed when the manual is built (`LeAnTeXManual.ApiMeta`), so a
page needs regenerating only when a module is added, removed or renamed, and the manual's build
says so when one is missing. Pages of modules that no longer exist are deleted.

`lake exe leantex-manual-api --check` writes nothing and fails when a page would change.
-/

/-- The header every generated file starts with. -/
def header : String :=
  "/-\nReleased under Apache 2.0 license as described in the file LICENSE.\n\
  Authors: Eric Vergo (Two-Circle Solutions), Claude (Anthropic)\n-/\n"

/-- The note that a file is generated. -/
def generatedNote : String :=
  "-- Generated by `lake exe leantex-manual-api` in manual/; regenerate rather than edit.\n"

/-- The modules of the library, from the source tree: `LeAnTeX` and every `LeAnTeX/….lean`. -/
partial def libraryModules (root : System.FilePath) : IO (Array String) := do
  let rec walk (dir : System.FilePath) (pre : String) : IO (Array String) := do
    let mut out := #[]
    for e in ← dir.readDir do
      if ← e.path.isDir then
        out := out ++ (← walk e.path s!"{pre}.{e.fileName}")
      else if e.fileName.endsWith ".lean" then
        out := out.push s!"{pre}.{(e.fileName.dropEnd 5).toString}"
    return out
  let mods := #["LeAnTeX"] ++ (← walk (root / "LeAnTeX") "LeAnTeX")
  return mods.qsort (· < ·)

/-- A module's page. -/
def page (mod : String) : String :=
  header ++ "import VersoManual\nimport LeAnTeXManual.ApiMeta\nimport " ++ mod ++ "\n\n" ++
    generatedNote ++ "\nopen Verso.Genre Manual\nopen LeAnTeXManual\n\n" ++
    "-- the largest modules' pages are deep terms for the code generator\n" ++
    "set_option maxRecDepth 20000\n\n" ++
    s!"#doc (Manual) \"{mod}\" =>\n%%%\ntag := \"api-{mod}\"\nhtmlSplit := .never\n%%%\n\n" ++
    s!"\{apiModule {mod}}\n"

/-- The index: imports every page and includes it. -/
def index (mods : Array String) : String :=
  let imports := String.join (mods.toList.map fun m => s!"import LeAnTeXManual.Api.{m}\n")
  let links := String.join (mods.toList.map fun m => s!"* \{api}`{m}`\n")
  let includes := String.join (mods.toList.map fun m => s!"\{include 1 LeAnTeXManual.Api.{m}}\n\n")
  header ++ "import VersoManual\nimport LeAnTeXManual.ApiMeta\nimport LeAnTeX\n" ++ imports ++
    "\n" ++ generatedNote ++ "\nopen Verso.Genre Manual\nopen LeAnTeXManual\n\n" ++
    "#doc (Manual) \"API Reference\" =>\n%%%\ntag := \"api-reference\"\n%%%\n\n" ++
    "One page per module of the library: the module's docstring, then each public declaration\n\
    with its signature and docstring, in the order of the source, taken from the code when the\n\
    manual is built. Names in signatures link to their definitions. A *source* line links the\n\
    file and line in the repository.\n\n" ++
    "The build fails when a module has no page, when a public declaration (or a field or\n\
    constructor it shows) has no docstring and is not on the allow-list\n\
    {file}`manual/api-allow.txt`, and when that list names a declaration that does not need\n\
    it. Instances, deprecated aliases and the declarations Lean generates (recursors,\n\
    projections, constructors, which appear in their type's block) are not listed.\n\n" ++
    "{apiIndex}\n\n" ++ links ++ "\n" ++ includes

/-- Writes `text` to `path` unless it is already there; whether it changed. -/
def put (check : Bool) (path : System.FilePath) (text : String) : IO Bool := do
  let old ← if ← path.pathExists then some <$> IO.FS.readFile path else pure none
  if old == some text then return false
  unless check do
    if let some d := path.parent then IO.FS.createDirAll d
    IO.FS.writeFile path text
  return true

/-- Every `.lean` file below `dir`. -/
partial def leanFiles (dir : System.FilePath) : IO (Array System.FilePath) := do
  unless ← dir.pathExists do return #[]
  let mut out := #[]
  for e in ← dir.readDir do
    if ← e.path.isDir then out := out ++ (← leanFiles e.path)
    else if e.fileName.endsWith ".lean" then out := out.push e.path
  return out

/-- Writes (or, with `--check`, compares) the pages; see the module docstring. -/
def main (args : List String) : IO UInt32 := do
  let check := args == ["--check"]
  let root : System.FilePath := ".."
  unless ← (root / "LeAnTeX.lean").pathExists do
    IO.eprintln "leantex-manual-api: run it in manual/ (../LeAnTeX.lean not found)"
    return 2
  let mods ← libraryModules root
  let mut changed : Array String := #[]
  let mut wanted : Array System.FilePath := #[]
  for m in mods do
    let path : System.FilePath :=
      ("LeAnTeXManual/Api" : System.FilePath) /
        (System.mkFilePath (m.splitOn ".")).addExtension "lean"
    wanted := wanted.push path
    if ← put check path (page m) then changed := changed.push path.toString
  if ← put check "LeAnTeXManual/Api.lean" (index mods) then
    changed := changed.push "LeAnTeXManual/Api.lean"
  for f in ← leanFiles "LeAnTeXManual/Api" do
    unless wanted.contains f do
      changed := changed.push s!"{f} (no such module)"
      unless check do IO.FS.removeFile f
  if check && !changed.isEmpty then
    IO.eprintln s!"the API pages are out of date (run lake exe leantex-manual-api): {changed}"
    return 1
  IO.println s!"{mods.size} modules; {changed.size} file(s) {if check then "differ" else "written"}"
  return 0
