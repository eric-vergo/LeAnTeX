import VersoManual
import LeAnTeXManual.Meta

/-!
# The API reference's elements

The API reference has one page per module of the library, generated by
`lake exe leantex-manual-api` (`ApiGen.lean`) into `LeAnTeXManual/Api/`. A page holds one
element, `{apiModule M}`, which lists the module when the page is elaborated:

* the module's file, linked to the repository, and its module docstring;
* every public declaration of the module, in the order of the source, as Verso's docstring block
  (its signature, with links and hovers, and its docstring).

The index page holds `{apiIndex}`, which counts the modules and declarations and fails the
build when a module of the library has no page; the generator writes the index's list of links.

## What is listed

A *public declaration* of a module is a constant the module declares that is not private, not
an implementation detail (`Name.isInternalDetail`), not an instance or a definition inside one (the `beq`, `repr` and `hash` functions
`deriving` makes), not generated by Lean (recursors, `casesOn`
and the other auxiliary definitions, `noConfusion`, constructors and structure projections,
which are shown in the block of their type), not deprecated, and that has a
position in the source. Instances are left out because they have no name a reader uses; a
deprecated alias is left out because the block of its replacement documents it.

## The coverage check

Every listed declaration must have a docstring, and so must the fields of its structure and the
constructors of its inductive type: a missing docstring fails the build. The only exception is
a name on the allow-list, `manual/api-allow.txt` (one name and the reason per line, after a
tab): its block is shown with what it has. A line of the allow-list that names a declaration
which has a docstring, or which is not listed at all, also fails the build, so the list cannot
outlive its reason.
-/

open Verso Genre Manual Doc Elab ArgParse
open Lean Elab

namespace LeAnTeXManual

/-- The allow-list: undocumented public declarations, with the reason for each. -/
def apiAllowList : IO (Array (Name × String)) := do
  let text ← IO.FS.readFile ((← repoRoot) / "manual" / "api-allow.txt")
  let mut out := #[]
  for l in text.splitOn "\n" do
    let l := l.trimAscii.toString
    if l.isEmpty || l.startsWith "#" then continue
    match l.splitOn "\t" with
    | [n, why] => out := out.push (n.trimAscii.toString.toName, why.trimAscii.toString)
    | _ => throw <| IO.userError s!"manual/api-allow.txt: a line is not `name<TAB>reason`: {l}"
  return out

/-- Whether `n` is generated by Lean rather than written in the source. -/
def generated (env : Environment) (n : Name) : Bool :=
  isAuxRecursor env n || isNoConfusion env n || isRecCore env n ||
    (match env.find? n with
      | some (.ctorInfo _) => true
      | some (.recInfo _) => true
      | _ => false) ||
    env.isProjectionFn n ||
    (match n with
      | .str _ s => ["injEq", "inj", "sizeOf_spec", "ext_iff", "ctorIdx", "toCtorIdx",
          "noConfusionType", "ofNat", "ctorElim", "ctorElimType"].contains s ||
          s.startsWith "_" || s.startsWith "match_" || s.startsWith "proof_" ||
          s.startsWith "eq_" || s.startsWith "fun_"
      | _ => false)

/-- The public declarations of module `mod` (see the module docstring), in source order, with
their lines. -/
def publicDecls (mod : Name) : CoreM (Array (Name × Nat)) := do
  let env ← getEnv
  let some idx := env.getModuleIdx? mod | throwError "{mod} is not imported"
  let mut out := #[]
  for (n, _) in env.constants.map₁.toList do
    unless env.getModuleIdxFor? n == some idx do continue
    if isPrivateName n || n.isInternalDetail || generated env n then continue
    if Meta.isInstanceCore env n || Meta.isInstanceCore env n.getPrefix then continue
    if Linter.isDeprecated env n then continue
    let some r ← findDeclarationRanges? n | continue
    out := out.push (n, r.range.pos.line)
  return out.qsort fun a b => a.2 < b.2 || (a.2 == b.2 && a.1.toString < b.1.toString)

/-- The parts of `n` that its docstring block shows and that have no docstring: `n` itself, a
structure's own fields, an inductive type's constructors. -/
def undocumentedParts (n : Name) : CoreM (Array Name) := do
  let env ← getEnv
  let has (m : Name) : CoreM Bool := return (← findDocString? env m).isSome
  let mut out := #[]
  unless ← has n do out := out.push n
  if isStructure env n then
    for f in getStructureFields env n do
      if (isSubobjectField? env n f).isSome then continue
      if let some p := getProjFnForField? env n f then
        unless isPrivateName p || (← has p) do out := out.push p
  else if let some (.inductInfo ii) := env.find? n then
    for c in ii.ctors do
      unless isPrivateName c || (← has c) do out := out.push c
  return out

/-- The repository path of module `mod`'s file. -/
def modulePath (mod : Name) : String :=
  "/".intercalate (mod.components.map (·.toString)) ++ ".lean"

block_extension Block.sourceLink (path : String) (line : Nat) where
  data := Json.arr #[Json.str path, toJson line]
  traverse _ _ _ := pure none
  toTeX := some fun _ _ _ _ _ => pure .empty
  toHtml := open Verso.Output.Html in some fun _ _ _ data _ => do
    match data with
    | .arr #[.str p, l] =>
      let line : Nat := (fromJson? l).toOption.getD 0
      let anchor := if line > 0 then s!"#L{line}" else ""
      let href := s!"{repositoryUrl}/blob/main/{p}{anchor}"
      let label := if line > 0 then s!"{p}:{line}" else p
      pure {{<div class="ltx-src">"source: "<a href={{href}}><code>{{label}}</code></a></div>}}
    | _ => pure .empty

/-- The argument of `apiModule`: the module. -/
structure ModuleArgs where
  /-- The module's name. -/
  name : Ident

instance : FromArgs ModuleArgs DocElabM where
  fromArgs := ModuleArgs.mk <$> .positional `name .ident

/-- The Verso blocks of a module docstring (Markdown, with Lean code elaborated where it can
be). -/
def moduleDocBlocks (mod : Name) : DocElabM (Array Term) := do
  let some docs := getModuleDoc? (← getEnv) mod | return #[]
  let mut out := #[]
  for d in docs do
    let some ast := MD4Lean.parse d.doc
      | throwError "the module docstring of {mod} is not Markdown MD4Lean reads"
    out := out ++ (← ast.blocks.mapM (blockFromMarkdownWithLean []))
  return out

/-- `{apiModule M}`: module `M`'s page (see the module docstring). -/
@[block_command]
def apiModule : BlockCommandOf ModuleArgs
  | {name} => do
    let mod := name.getId
    let allow ← apiAllowList
    let src ← ``(Block.other (Block.sourceLink $(quote (modulePath mod)) 0) #[])
    let doc ← moduleDocBlocks mod
    let mut blocks : Array Term := #[src] ++ doc
    let mut missing : Array Name := #[]
    for (n, line) in ← publicDecls mod do
      let gaps ← undocumentedParts n
      let allowed := gaps.all fun g => allow.any (·.1 == g)
      unless gaps.isEmpty || allowed do
        missing := missing ++ gaps.filter fun g => !allow.any (·.1 == g)
        continue
      blocks := blocks.push
        (← ``(Block.other (Block.sourceLink $(quote (modulePath mod)) $(quote line)) #[]))
      let saved := (← getThe Core.State).messages
      let b ← Verso.Genre.Manual.docstring
        { name := (mkIdent n, n), allowMissing := !gaps.isEmpty }
      -- an allowed gap: the allow-list is the record, not a warning in every build
      unless gaps.isEmpty do modifyThe Core.State fun s => { s with messages := saved }
      blocks := blocks.push b
    unless missing.isEmpty do
      throwErrorAt name "public declarations without a docstring (write one, or add the name \
        with its reason to manual/api-allow.txt): {missing.toList}"
    ``(Block.concat #[$blocks,*])

/-- The modules of the library: every imported module named `LeAnTeX` or `LeAnTeX.…`. -/
def libraryModules (env : Environment) : Array Name :=
  (env.header.moduleNames.filter fun m => m == `LeAnTeX || (`LeAnTeX).isPrefixOf m).qsort
    (·.toString < ·.toString)

/-- `{apiIndex}`: the number of modules and public declarations of the library, after checking that each has a page (`LeAnTeXManual.Api.M` imported) and that the allow-list holds
only names that need it. -/
@[block_command]
def apiIndex : BlockCommandOf Unit
  | () => do
    let env ← getEnv
    let mods := libraryModules env
    let noPage := mods.filter fun m => !env.header.moduleNames.contains (`LeAnTeXManual.Api ++ m)
    unless noPage.isEmpty do
      throwError "modules without an API page (run `lake exe leantex-manual-api` in manual/): \
        {noPage.toList}"
    let allow ← apiAllowList
    let mut total := 0
    let mut allLists : Array Name := #[]
    for m in mods do
      let ds ← publicDecls m
      total := total + ds.size
      for (n, _) in ds do
        allLists := allLists.push n
        allLists := allLists ++ (← undocumentedParts n)
    for (n, _) in allow do
      unless allLists.contains n do
        throwError "manual/api-allow.txt names {n}, which is not a public declaration of the \
          library: remove the line"
      unless (← undocumentedParts n).contains n || (← findDocString? env n).isNone do
        throwError "manual/api-allow.txt names {n}, which has a docstring: remove the line"
    let html := s!"<p>{mods.size} modules, {total} public declarations, {allow.size} on the \
      allow-list of undocumented names.</p>"
    ``(Block.other (Block.rawHtml $(quote html)) #[])

end LeAnTeXManual
