/-- The code points of every family's slots, as `(family, slot, code point)`; the family is that
of `fontFamily` with the bold faces `cmbx`, `cmmib`, `cmbsy` read as their regular faces (`cmr`,
`cmmi`, `cmsy`). The `cmex` slots are in `sizedTable`. -/
def glyphTable : Array (String × Nat × Nat) :=
  ot1Table.map (fun (s, c) => ("cmr", s, c)) ++ omlTable.map (fun (s, c) => ("cmmi", s, c)) ++
  omsTable.map (fun (s, c) => ("cmsy", s, c)) ++ msamTable.map (fun (s, c) => ("msam", s, c)) ++
  msbmTable.map (fun (s, c) => ("msbm", s, c)) ++ eufmTable.map (fun (s, c) => ("eufm", s, c)) ++
  eufbTable.map (fun (s, c) => ("eufb", s, c))

/-- The `cmex` slots as `(slot, face, code point)` (see `largeOf`). -/
def sizedTable : Array (Nat × String × Nat) := omxTable

/-- The family a metric file's table is kept under: a bold face shares its regular face's. -/
def tableFamily (name : String) : String :=
  match fontFamily name with
  | "cmbx" => "cmr"
  | "cmmib" => "cmmi"
  | "cmbsy" => "cmsy"
  | fam => fam

/-- The characters of `glyphTable`, by family and slot. -/
def glyphMap : Std.HashMap (String × Nat) Char :=
  Std.HashMap.ofList (glyphTable.toList.map fun (fam, s, c) => ((fam, s), Char.ofNat c))

/-- The `cmex` slots' face and base character, by slot. -/
def sizedMap : Std.HashMap Nat (String × Char) :=
  Std.HashMap.ofList (sizedTable.toList.map fun (s, face, c) => (s, (face, Char.ofNat c)))

/-- The character slot `slot` of the metric file `name` shows, if known: `none` for a slot that
is not a character (an arrow's shaft, a hook piece, an accent that is part of a construction)
and for a font that is not one of the Computer Modern or AMS math fonts. For `cmex` it is the
base character of `largeOf`. -/
def unicodeOf (name : String) (slot : Nat) : Option Char :=
  if tableFamily name == "cmex" then (sizedMap[slot]?).map (·.2)
  else glyphMap[(tableFamily name, slot)]?

/-- For a slot of a `cmex` metric file, the face that draws it and the base character: `Size1`
to `Size4` select the size variant of the OpenType math font's `MATH` table (`\big` to `\Bigg`
delimiters, text-style operators and radicals at `Size1`, display-style operators at `Size2`,
wide accents `Size1` to `Size3`), and the empty face is an extensible piece. -/
def largeOf (name : String) (slot : Nat) : Option (String × Char) :=
  if tableFamily name == "cmex" then sizedMap[slot]? else none

end LeAnTeX.TeXMath.Data
